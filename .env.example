# Crayon runtime settings. Copy to .env for local runs, or set these on your host (Render).
# Never commit real values.

# --- Required ---
TELEGRAM_BOT_TOKEN=          # from @BotFather
GEMINI_API_KEY=              # Google AI Studio key
DATABASE_URL=                # Neon Postgres connection string

# --- Needed for /selftest ---
CRAYON_ADMIN_TOKEN=          # Bearer token that guards POST /selftest (it returns 403 without it)

# --- Recommended ---
TAVILY_API_KEY=              # web search; without it Crayon falls back to DuckDuckGo, Mojeek, Wikipedia

# --- Optional (defaults shown) ---
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
CRAYON_TZ=Asia/Kolkata       # default timezone for reminders
CRAYON_MODE=polling
CRAYON_PUBLIC_URL=https://crayon-v1.onrender.com
CRAYON_HISTORY_TURNS=14      # chat turns kept in the prompt
CRAYON_DAILY_CAP=80          # messages per user per day
CRAYON_VERIFY=1              # 1 = one-pass self-check on factual answers, 0 = off
# PORT is set by Render; locally it defaults to 10000
